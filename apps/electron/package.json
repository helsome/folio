{
  "name": "@finagent/electron",
  "version": "0.4.0-beta.2",
  "private": true,
  "folio": {
    "channel": "beta"
  },
  "type": "module",
  "main": "./src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run build:preload && bun run build:main",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/run.mjs",
    "test:product-flows": "node e2e/product-flows.mjs",
    "test:interactions": "node e2e/interactions.mjs",
    "test:skills-interactions": "node e2e/skills-interactions.mjs",
    "test:fresh-install": "node e2e/fresh-install.mjs",
    "test:package-smoke": "node e2e/package-smoke.mjs",
    "build:preload": "bun build src/preload/index.ts --outfile src/preload/index.cjs --target node --format cjs --external electron",
    "build:main": "bun build src/main/index.ts --outfile src/main/index.js --bundle --target node --format esm --external electron",
    "build:extension": "bun build ../../.pi/extensions/finagent/index.ts --outfile build/extensions/finagent/index.js --bundle --target node --format esm && bun build ../../.pi/extensions/langsmith/index.ts --outfile build/extensions/langsmith/index.js --bundle --target node --format esm",
    "package": "bun run build && bun run build:extension && bun run package:builder",
    "package:builder": "electron-builder",
    "test:v5": "node e2e/v5.mjs"
  },
  "dependencies": {
    "@finagent/core": "workspace:*",
    "@finagent/longbridge-tools": "workspace:*",
    "@finagent/pi-extension": "workspace:*",
    "@finagent/shared": "workspace:*",
    "@finagent/skill-hub": "workspace:*",
    "@finagent/ui": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@finagent/i18n": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "electron": "^39.0.0"
  },
  "build": {
    "appId": "com.finagent.app",
    "productName": "Folio",
    "directories": {
      "output": "../../dist/electron"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../../skills",
        "to": "skills"
      },
      {
        "from": "build/extensions",
        "to": "extensions"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "identity": null
    }
  }
}
