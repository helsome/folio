{
  "name": "@finagent/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@finagent/ui": "workspace:*",
    "@finagent/core": "workspace:*",
    "@finagent/shared": "workspace:*",
    "@finagent/longbridge-tools": "workspace:*",
    "@finagent/pi-extension": "workspace:*",
    "electron": "^39.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.finagent.app",
    "productName": "Finance Agent",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "src/**/*",
      "../../packages/ui/dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
